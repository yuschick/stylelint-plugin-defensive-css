{
  "name": "stylelint-plugin-defensive-css",
  "version": "2.10.0",
  "description": "A Stylelint plugin to enforce defensive CSS best practices.",
  "type": "module",
  "author": "Daniel Yuschick <daniel.yuschick@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/yuschick/stylelint-plugin-defensive-css",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./configs/accessibility": {
      "import": "./dist/configs/accessibility.mjs",
      "require": "./dist/configs/accessibility.cjs"
    },
    "./configs/recommended": {
      "import": "./dist/configs/recommended.mjs",
      "require": "./dist/configs/recommended.cjs"
    },
    "./configs/strict": {
      "import": "./dist/configs/strict.mjs",
      "require": "./dist/configs/strict.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "release:official": "release-it --config .release-it--official.json",
    "release:dry": "release-it --dry-run",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/node": "^25.1.0",
    "csstype": "^3.2.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "stylelint": "^16.1.0",
    "tsdown": "^0.21.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4",
    "vitest-stylelint-utils": "^2.0.0"
  },
  "peerDependencies": {
    "stylelint": "^16.7.0 || ^17.0.0 || ^18.0.0"
  },
  "keywords": [
    "css",
    "css lint",
    "defensive css",
    "lint",
    "linter",
    "stylelint",
    "stylelint plugin",
    "stylelint-plugin",
    "best practices"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuschick/stylelint-plugin-defensive-css.git"
  },
  "bugs": {
    "url": "https://github.com/yuschick/stylelint-plugin-defensive-css/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
